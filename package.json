{
  "name": "mahakam-moonlight-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Situs resmi Mahakam Moonlight Studio — Tailwind CSS v4 build",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o assets/css/main.css --minify",
